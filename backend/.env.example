# Council backend environment
# Copy to .env for local `go run ./cmd/server` or `docker compose up`.

# Required, fails fast at startup if missing. Never commit the real value.
ZAI_API_KEY=your-zai-api-key-here

# Optional, defaults to :8080. docker-compose.yml overrides this to :10000
# to match backend/Dockerfile's EXPOSE and render.yaml's production config.
BACKEND_ADDR=:8080

# Optional, comma-separated allowlist of frontend origins for CORS/WS checks.
# Defaults to localhost:5173, matching both the Vite dev server and the
# docker-compose frontend service's published host port.
FRONTEND_ORIGINS=localhost:5173

# Optional, defaults to glm-4.7.
LLM_MODEL=glm-4.7

# --- Phase 5: rate limiting, capacity, and per-IP daily quota ---
# All optional; the defaults below are used if a variable is unset.
# A value that is set but invalid (e.g. RATE_LIMIT_RPS=abc) fails fast at startup.

# Per-IP token bucket. Burst is the bucket size; RPS is the steady refill rate.
RATE_LIMIT_RPS=1.0
RATE_LIMIT_BURST=3
# How long an idle IP's bucket is kept before the janitor evicts it, and how
# often the janitor sweeps.
RATE_LIMIT_TTL=10m
RATE_LIMIT_SWEEP=1m

# Global cap on concurrent debates (WebSocket sessions). Each session holds a
# slot for the whole debate; overflow gets 503 Service Unavailable.
MAX_CONCURRENT_SESSIONS=6

# Per-IP soft daily cap on debates started. Over-limit requests still increment
# (count-then-check) to keep the counter race-free; an over-limit client gets
# 429.
DAILY_QUOTA=20

# SQLite path for the daily quota counter. Use a file path for durability, or
# file::memory: for ephemeral runs. WAL creates -wal/-shm sidecars, so the
# parent directory must be writable.
DB_PATH=./council.db

# Trust the leftmost X-Forwarded-For entry for client IP. Set to true ONLY
# behind a reverse proxy you control (Render/Fly), or clients can spoof their IP
# to mint fresh rate-limit buckets.
TRUST_PROXY=false
